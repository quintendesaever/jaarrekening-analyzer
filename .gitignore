# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Local persisted ratio overrides (admin save / non-volume host copies)
backend/data/

# OS & editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?

# Cursor (local IDE state)
.cursor/

# Local git hooks (niet op GitHub)
.githooks/

# Tests (lokaal, behalve tracked config tests)
backend/tests/*
!backend/tests/test_ratio_config.py
!backend/tests/test_table_config.py

# Secrets — never commit real values
.env
.env.*
!.env.example

# Optional local Compose overlays (tracked file is docker-compose.yml only)
docker-compose.*.yml
docker-compose.override.yml

# Runtime / uploads / logs (not application source)
*.log
uploads/
*.pdf
!backend/tests/**/*.pdf
