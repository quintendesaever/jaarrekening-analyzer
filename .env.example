# Required for live ratio/table configuration writes (PUT / reset / restore).
# Generate a random secret. Never commit the real value.
ADMIN_TOKEN=<random-secret>

# Optional. Defaults suit Vite local dev. Production SPA is same-origin via Caddy,
# so this usually does not need to include trycloudflare hostnames.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
